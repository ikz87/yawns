/* =====================================================================
 * Change your colors here. Every "@name" below can be used anywhere in
 * this file (e.g. "background-color: @surface;").
 * This also means you can add your own variables if needed
 * ===================================================================== */

@accent: #FFE001;                     /* borders, progress bars */
@background: #24272F;                  /* yawn background */
@surface: #0F1013;                     /* inner panels and bars */
@button: #24272F;                      /* buttons */
@text: #ffffff;                        /* main text */
@muted: #888888;                       /* secondary text */
@transparent: rgba(0, 0, 0, 0);

/* ===================================================================== */

/* 
 * Everything below this point manages the layout of the notifications
 * have fun :)
 */


* {
    background-color: @transparent;
    color: @text;
    font-family: Iosevka Curly;
    font-size: 16px;
}

#CornerYawn {
    background-color: @background;
    border-radius: 20px;
    border: 5px solid @accent;
    padding: 10px;
}

#CornerYawnIcon {
    margin-right: 10px;
    border-radius: 10px;
    padding: 10px;
    background-color: @surface;
}

#CornerYawnTextContainer {
    background-color: @surface;
    border-radius: 10px;
    padding: 10px;
}

#CornerYawnSummary {
    background-color: @transparent;
    font-weight: 700;
}

#CornerYawnBar {
    height: 5px;
    border-radius: 10px;
    margin-top: 10px;
    padding: 7.5px;
    background-color: @surface;
}

#CornerYawnButtonsContainer {
    background-color: @surface;
    margin-top: 10px;
    border-radius: 10px;
    padding: 5px;
}

#CornerYawnActionButton, #CornerYawnCloseButton {
    border-radius: 5px;
    margin: 5px;
    padding: 5px;
    background-color: @button;
    border: 2px solid @button;
}

#CornerYawnActionButton:hover, #CornerYawnCloseButton:hover {
    border-radius: 5px;
    margin: 5px;
    padding: 5px;
    border: 2px solid @text;
}

#CornerYawnActionButton:pressed, #CornerYawnCloseButton:pressed {
    border-radius: 5px;
    margin: 5px;
    padding: 5px;
    margin-top: 7px;
    border: 2px solid @text;
    margin-bottom: 3px;
}

#CornerYawnBar::chunk {
    width: 1px;
    background-color: @accent;
}

#CenterYawn {
    background-color: @background;
    border-radius: 20px;
    border: 5px solid @accent;
    padding: 10px
}

#CenterYawnIcon {
    margin-bottom: 10px;
}

#CenterYawnTextContainer {
    background-color: @surface;
    border-radius: 10px;
    padding: 10px;
}

#CenterYawnSummary {
    background-color: @transparent;
    font-weight: 700;
}

#CenterYawnBody {
    background-color: @transparent;
}

#CenterYawnBar {
    height: 5px;
    border-radius: 10px;
    margin-top: 6px;
    padding: 7.5px;
    background-color: @surface;
}

#CenterYawnBar::chunk {
    width: 1px;
    background-color: @accent;
}

#MediaYawn {
    background-color: @background;
    border-radius: 20px;
    border: 5px solid @accent;
    padding: 10px;
}

#MediaYawnIcon {
    margin-right: 10px;
    border-radius: 10px;
    padding: 10px;
    background-color: @surface;
}

#MediaYawnTextContainer {
    background-color: @surface;
    border-radius: 10px;
    padding: 10px;
}

#MediaYawnSummary {
    background-color: @transparent;
    font-weight: 700;
}

#MediaYawnBar {
    height: 5px;
    border-radius: 10px;
    margin-top: 10px;
    padding: 7.5px;
    background-color: @surface;
}

#MediaYawnButtonsContainer {
    background-color: @surface;
    margin-top: 10px;
    border-radius: 10px;
    padding: 5px;
}

#MediaYawnActionButton, #MediaYawnCloseButton {
    border-radius: 5px;
    margin: 5px;
    padding: 5px;
    background-color: @button;
    border: 2px solid @button;
}

#MediaYawnActionButton:hover, #MediaYawnCloseButton:hover {
    border-radius: 5px;
    margin: 5px;
    padding: 5px;
    border: 2px solid @text;
}

#MediaYawnActionButton:pressed, #MediaYawnCloseButton:pressed {
    border-radius: 5px;
    margin: 5px;
    padding: 5px;
    margin-top: 7px;
    border: 2px solid @text;
    margin-bottom: 3px;
}

#MediaYawnHeader {
    font-size: 13px;
    font-weight: 400;
    color: @muted;
    margin-bottom: 5px;
    margin-top: 5px;
}

#MediaYawnControls {
    background-color: @surface;
    margin-top: 10px;
    border-radius: 10px;
    padding: 5px;
}

#MediaYawnControlButton {
    border-radius: 5px;
    margin: 5px;
    padding: 8px 16px;
    background-color: @button;
    border: 2px solid @button;
    font-size: 18px;
}

#MediaYawnControlButton:hover {
    border: 2px solid @text;
}

#MediaYawnControlButton:pressed {
    margin-top: 7px;
    margin-bottom: 3px;
    border: 2px solid @text;
}
